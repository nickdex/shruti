{:source-paths ["src/main" "src/test"]
 :dependencies [[reagent "2.0.1"]]
 :dev-http {8280 "public"}
 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn shruti.app/init}}
   :devtools {:after-load shruti.app/reload!}
   :compiler-options {:infer-externs :auto}}

  :test
  {:target :node-test
   :output-to "target/node-tests.cjs"
   :ns-regexp "-test$"}}}
