<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/record_widget_background"
    android:contentDescription="@string/widget_record"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:src="@drawable/record_widget_microphone" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/shortcut_record"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
